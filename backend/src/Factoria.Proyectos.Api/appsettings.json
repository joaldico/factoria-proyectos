{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LogSettings": {
    "RutaLog": ".Logs",
    "NombreLog": "LogError"
  },
  "Jwt": {
    "Issuer": "Factoria.Api",
    "Audience": "Factoria.Client",
    "ExpireMinutes": 30,
    "RefreshExpireDays": 7
  },
  "RutaEnv": ".env",
  "AllowedHosts": "*"
}
